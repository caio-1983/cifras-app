# Copie para .env e ajuste. O serviço lê este arquivo via systemd
# (EnvironmentFile em deploy/cifras.service).

# Porta local do processo Node. O nginx faz proxy para ela.
# Escolha uma que não colida com os outros sites da VPS.
CIFRAS_PORTA=3000

# Interface de escuta. 127.0.0.1 é o padrão e o certo: o gate de acesso é o
# basic auth do nginx, então o Node NÃO pode estar alcançável de fora.
# Trocar para 0.0.0.0 expõe o acervo sem senha.
CIFRAS_HOST=127.0.0.1

# Caminho do repertório. Padrão: dados/repertorio.json ao lado do código.
# Gere/atualize com: python gerador/scripts/exportar_repertorio_json.py
CIFRAS_REPERTORIO=/opt/cifras/dados/repertorio.json

# Nível de log do Fastify: fatal, error, warn, info, debug, trace, silent.
CIFRAS_LOG=info

# Opcional: aparece em GET /saude, útil para saber qual versão está no ar.
#CIFRAS_VERSAO=
